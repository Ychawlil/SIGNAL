# ============================================================
# SIGNAL — server-side configuration
# Copy to .env.local and fill in values. Never commit real keys.
# ============================================================

# GitHub personal access token (optional).
# Unauthenticated GitHub API is limited to 60 requests/hour;
# a token raises the limit to 5000/hour.
GITHUB_TOKEN=

# Comma-separated RSS / Atom feed URLs (optional).
# Used by the generic blog/media provider. Each URL is SSRF-validated
# (https/http only, public IPs only) before fetching. Example of verified
# public feeds (uncomment to enable):
# RSS_FEEDS=https://news.mit.edu/rss/topic/artificial-intelligence2,https://www.technologyreview.com/feed/,https://deepmind.google/blog/rss.xml,https://openai.com/news/rss.xml
RSS_FEEDS=

# Optional overrides.
# SIGNAL_DB_PATH=/absolute/path/to/signal.db
# SIGNAL_REQUEST_TIMEOUT_MS=15000
# SIGNAL_MIN_REQUEST_INTERVAL_MS=1000

# Optional LLM analysis engine (OpenAI-compatible chat completions).
# Without a key, SIGNAL uses the built-in deterministic rule-based analyzer.
# LLM_ANALYZER_API_KEY=
# LLM_ANALYZER_BASE_URL=https://api.openai.com/v1
# LLM_ANALYZER_MODEL=gpt-4o-mini

# ============================================================
# Automation & access control
# ============================================================

# Enable the in-process scheduler (runs sync → analyze → briefing → trends).
# Interval in milliseconds (default 21600000 = 6 hours; minimum 15000).
SIGNAL_SCHEDULER_ENABLED=false
# SIGNAL_SCHEDULER_INTERVAL_MS=21600000

# Optional admin token for manual-update / admin endpoints.
# When set, POST /api/intelligence/sync, /api/analysis/run, /api/trends/collect
# and /api/tasks/run require the admin token in the Authorization or
# X-Admin-Token header. Leave empty for a trusted local single-user setup.
SIGNAL_ADMIN_TOKEN=
